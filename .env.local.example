# ============================================
# MedAI Pro - Environment Variables
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/medai_pro"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"

# WeChat OAuth
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"

# JWT Configuration
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI API (kuaipao.ai)
OPENAI_API_KEY="sk-your-api-key"
OPENAI_BASE_URL="https://kuaipao.ai/v1"
OPENAI_MODEL="gpt-4o"
DALL_E_MODEL="gpt-image-2"

# Admin
ADMIN_EMAIL="admin@medai.pro"
ADMIN_PASSWORD="change-me-in-production"

# Upload
UPLOAD_MAX_SIZE="10485760"
UPLOAD_DIR="./public/uploads"

# Redis (optional, for caching)
REDIS_URL="redis://localhost:6379"
