// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MedAI Pro - Database Schema
// ============================================

/// User model - platform users and administrators
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  avatar         String?
  role           Role      @default(USER)
  wechatOpenId   String?   @unique
  wechatUnionId  String?   @unique
  phone          String?   @unique
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  isBanned       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    Membership[]
  orders         Order[]
  generationLogs GenerationLog[]
  adminLogs      AdminLog[]
  userPrompts    UserPrompt[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

/// Membership model - subscription tiers and credits
model Membership {
  id               String           @id @default(cuid())
  userId           String
  tier             MembershipTier   @default(FREE)
  creditsRemaining Int              @default(3)
  creditsTotal     Int              @default(3)
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean          @default(true)
  autoRenew        Boolean          @default(false)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
}

enum MembershipTier {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

/// Order model - payment and subscription records
model Order {
  id              String      @id @default(cuid())
  userId          String
  type            OrderType   @default(SUBSCRIPTION)
  amount          Int         // Stored in cents (e.g., 9900 = ¥99.00)
  currency        String      @default("CNY")
  status          OrderStatus @default(PENDING)
  membershipTier  MembershipTier?
  creditsAdded    Int?
  paymentMethod   String      @default("wechat_pay")
  transactionId   String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("orders")
}

enum OrderType {
  SUBSCRIPTION
  CREDIT_TOPUP
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Prompt model - AI system prompts and templates
model Prompt {
  id                String    @id @default(cuid())
  name              String
  description       String    @default("")
  category          PromptCategory @default(GENERAL)
  systemPrompt      String
  userPromptTemplate String   @default("")
  variables         String[]  @default([])
  model             String    @default("gpt-4-turbo-preview")
  temperature       Float     @default(0.7)
  maxTokens         Int       @default(2000)
  isPublished       Boolean   @default(false)
  usageCount        Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  skills            Skill[]

  @@map("prompts")
}

enum PromptCategory {
  HYPOTHESIS
  ROADMAP
  IMAGE
  GENERAL
}

/// Skill model - composite AI skills combining multiple prompts
model Skill {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  category    String   @default("")
  icon        String   @default("Zap")
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prompts     Prompt[] @relation("SkillPrompts")
  promptIds   String[]

  @@map("skills")
}

/// GenerationLog model - tracks all AI generation events
model GenerationLog {
  id           String         @id @default(cuid())
  userId       String
  type         GenerationType
  input        String         @db.Text
  output       String         @db.Text
  imageUrl     String?
  tokensUsed   Int            @default(0)
  duration     Int            @default(0) // in milliseconds
  status       GenStatus      @default(SUCCESS)
  errorMessage String?
  createdAt    DateTime       @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("generation_logs")
}

enum GenerationType {
  HYPOTHESIS
  ROADMAP
  IMAGE
}

enum GenStatus {
  SUCCESS
  FAILED
}

/// AdminLog model - audit trail for admin actions
model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String
  details   String   @default("")
  ipAddress String   @default("")
  createdAt DateTime @default(now())

  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_logs")
}

/// UserPrompt model - user's personal saved prompts
model UserPrompt {
  id           String    @id @default(cuid())
  userId       String
  name         String
  description  String    @default("")
  systemPrompt String
  category     String    @default("GENERAL")
  usageCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_prompts")
}
